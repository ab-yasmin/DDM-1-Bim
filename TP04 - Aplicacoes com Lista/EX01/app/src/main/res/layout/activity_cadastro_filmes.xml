<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <EditText
        android:id="@+id/edt_titulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Digite o título do filme"
        app:layout_constraintBottom_toTopOf="@id/edt_diretor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/edt_diretor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Digite o diretor do filme"
        app:layout_constraintBottom_toTopOf="@id/btn_adicionar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edt_titulo" />

    <Button
        android:id="@+id/btn_adicionar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Adicionar Filme"
        app:layout_constraintBottom_toTopOf="@id/btn_visualizar_filmes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edt_diretor" />

    <Button
        android:id="@+id/btn_visualizar_filmes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Visualizar Filmes"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_adicionar" />

</androidx.constraintlayout.widget.ConstraintLayout>